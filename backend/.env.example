# backend/.env.example - 复制为 .env 并填入真实 key

# LLM 配置（HelloAgents 框架自动检测 provider）
# GLM 是 OpenAI 兼容接口，框架会用 OpenAI 兼容适配器
LLM_MODEL_ID=glm-5.2
LLM_API_KEY=your-glm-api-key-here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 高德地图 API（H5a 阶段接入 MCP 用）
AMAP_API_KEY=your-amap-api-key-here

# Unsplash API（H9 可选，景点图片）
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here

# 小红书 MCP（H9 可选，预留）
XIAOHONGSHU_MCP_URL=http://localhost:18060/mcp
# 云端小红书检索服务（Docker 部署时由 compose 自动使用；本地可留空）
XHS_SEARCH_URL=

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# context 目录（session 文件存储）
CONTEXT_ROOT=context

# 匿名试用额度（逗号分隔的开发者匿名身份可不限额）
ADMIN_USER_IDS=
QUOTA_FULL_GUIDES_PER_DAY=3
QUOTA_INSPIRATION_GUIDES_PER_DAY=5
QUOTA_PLANS_PER_DAY=3
QUOTA_REVISIONS_PER_DAY=5
