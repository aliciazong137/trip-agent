{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "poi-list.schema.json",
  "title": "PoiList",
  "type": "object",
  "required": ["city", "pois"],
  "additionalProperties": false,
  "properties": {
    "city": { "type": "string" },
    "pois": {
      "type": "array",
      "items": { "$ref": "#/$defs/poi" }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["type", "ref"],
      "properties": {
        "type": { "type": "string", "enum": ["guide", "whitelist", "external"] },
        "ref": { "type": "string" },
        "snippet": { "type": "string" }
      }
    },
    "poi": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "area",
        "source_refs",
        "confidence",
        "priority"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^poi_" },
        "name": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "category": {
          "type": "string",
          "enum": ["attraction", "restaurant", "shopping", "experience", "transport"]
        },
        "area": { "type": "string" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "priority": { "type": "string", "enum": ["must", "nice", "optional"] },
        "estimated_duration_minutes": { "type": "integer", "minimum": 0 },
        "estimated_cost": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "object", "required": ["unknown"], "properties": { "unknown": { "const": true } } }
          ]
        },
        "opening_hours": { "type": "string" },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
