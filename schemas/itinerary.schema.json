{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "itinerary.schema.json",
  "title": "Itinerary",
  "type": "object",
  "required": ["sessionId", "city", "days", "version"],
  "additionalProperties": false,
  "properties": {
    "sessionId": { "type": "string" },
    "city": { "type": "string" },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dayPlan" }
    },
    "version": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "timeBlock": {
      "type": "object",
      "required": ["poi_id", "start_time", "end_time", "reason"],
      "additionalProperties": false,
      "properties": {
        "poi_id": { "type": "string", "pattern": "^poi_" },
        "start_time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "end_time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "reason": { "type": "string" },
        "locked": { "type": "boolean" }
      }
    },
    "dayPlan": {
      "type": "object",
      "required": [
        "day",
        "area_cluster",
        "time_blocks",
        "estimated_total_cost",
        "estimated_total_minutes"
      ],
      "additionalProperties": false,
      "properties": {
        "day": { "type": "integer", "minimum": 1 },
        "area_cluster": { "type": "array", "items": { "type": "string" } },
        "time_blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/timeBlock" }
        },
        "estimated_total_cost": { "type": "number", "minimum": 0 },
        "estimated_total_minutes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
